# Local $0 substrate environment — copy to .env.local and source before running
# host-side scripts (seed / embeddings / graph). The compose services get their
# own env from docker-compose.yml; this file is for processes you run on the host
# (or inside the repo venv) that talk to the local substitutes.
#
# No secrets. No cloud project ids. Everything points at localhost containers.

# reporium-api stub (Cloud Run -> local FastAPI)
REPORIUM_API_URL=http://localhost:58000
REPORIUM_API_KEY=local-dev
INGEST_API_KEY=local-dev

# Postgres + pgvector (Cloud SQL -> local pgvector). Host port 55432.
DATABASE_URL=postgresql://reporium:reporium@localhost:55432/reporium

# Local embedder (paid embeddings / Ollama -> stub embedder). Host port 11434.
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=stub-embed-384

# Graph snapshot -> local file (GCS substitute). MinIO bucket also available at
# http://localhost:59000 (bucket: reporium-graph) if you prefer the S3 path.
GRAPH_SNAPSHOT_LOCAL_PATH=./local/out/knowledge-graph.json
GRAPH_SNAPSHOT_OBJECT=reporium/graph/knowledge-graph.json

# Pub/Sub emulator (GCP Pub/Sub -> emulator). Unset topic => publish is a
# graceful no-op (the app skips silently). To exercise the emulator instead,
# set PUBSUB_EMULATOR_HOST and a topic path.
# PUBSUB_EMULATOR_HOST=localhost:58085
# PUBSUB_REPO_INGESTED_TOPIC=projects/reporium-local/topics/repo-ingested
PUBSUB_REPO_INGESTED_TOPIC=

# GitHub — only needed for the full live `python -m ingestion run` path, which
# fetches real repos. The local smoke does NOT call GitHub. Leave blank for the
# hermetic smoke; set a PAT to drive a real ingestion against local substitutes.
GH_TOKEN=
GH_USERNAME=perditioinc

# Claude enrichment — intentionally blank. Enrichment degrades gracefully when
# unset (see ingestion/main.py). The substrate is $0; no paid calls are made.
ANTHROPIC_API_KEY=
ENRICHMENT_MODEL=claude-sonnet-4-20250514

CACHE_DB_PATH=./local/out/cache.db
DEFAULT_RUN_MODE=quick
